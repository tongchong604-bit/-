{
  "manifest_version": 3,
  "name": "图文参考采集助手",
  "version": "0.1.1",
  "description": "在自己正常打开的抖音图文页采集正文和配图，按大小分包导出，供整理参考。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.pstatp.com/*"
  ],
  "action": {
    "default_title": "采集当前抖音图文",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
